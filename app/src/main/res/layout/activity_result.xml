<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Result"
    android:background="@color/background"
    tools:context=".ResultActivity"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/layoutTitleResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/background"
        android:elevation="4dp"
        >
        <TextView
            android:id="@+id/textTitleResult"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titleResult"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:padding="10sp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/layoutSubtitleResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layoutTitleResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="15dp">
        <TextView
            android:id="@+id/textSubtitleResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitleResult"
            android:textSize="40sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewCalcResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/layoutSubtitleResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cardViewReCalculate"
        app:cardBackgroundColor="@color/secondCardBackground"
        app:strokeColor="@color/secondCardBackground"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="30dp">
        <LinearLayout
            android:id="@+id/layoutCalcResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:gravity="center">
            <TextView
                android:id="@+id/textViewResulTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/textCardViewTitle"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="40sp"
                android:gravity="center"
                android:layout_marginTop="30dp">
            </TextView>
            <TextView
                android:id="@+id/textViewResult"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:text="@string/resultText"
                android:textColor="@color/white"
                android:textSize="100sp"
                android:textStyle="bold"
                android:gravity="center"
                >
            </TextView>
            <TextView
                android:id="@+id/textViewSubtitleResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/textCardViewSubtitle"
                android:textSize="25sp"
                android:textColor="@color/white"
                android:gravity="center_horizontal">
            </TextView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewReCalculate"
        app:layout_constraintTop_toBottomOf="@+id/cardViewCalcResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="0sp"
        android:layout_height="80dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintVertical_bias="1.0"
        app:cardBackgroundColor="@color/colorBarraAndCalculate"
        app:strokeColor="@color/colorBarraAndCalculate">
        <TextView
            android:id="@+id/textViewReCalculate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/textReCalculate"
            android:textSize="30sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp">
        </TextView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>