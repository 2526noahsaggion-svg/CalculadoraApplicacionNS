<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/background">
    <LinearLayout
        android:id="@+id/layoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/background"
        android:elevation="4dp"
        >
        <TextView
            android:id="@+id/title"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:padding="10sp"
            android:gravity="center"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMale"
        android:layout_width="0dp"
        android:layout_height="170dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardFemale"
        android:layout_margin="15dp"
        app:cardBackgroundColor="@color/cardBackground"
        app:strokeColor="@color/cardBackground">
        <LinearLayout
            android:id="@+id/layoutCardMale"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables"
            >
        <ImageView
            android:id="@+id/imageMale"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/baseline_male_24"
            android:layout_marginTop="15dp"
            android:layout_gravity="center"
            android:contentDescription="@string/DescriptionImageMale"/>

        <TextView
            android:id="@+id/textSimbolMale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitleSimbolMale"
            android:textColor="@color/titleColor"
            android:gravity="center"
            android:textSize="20sp"
            />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFemale"
        android:layout_width="0dp"
        android:layout_height="170dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTitle"
        app:layout_constraintStart_toEndOf="@id/cardMale"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="15dp"
        app:cardBackgroundColor="@color/cardBackground"
        app:strokeColor="@color/cardBackground"
        >
        <LinearLayout
            android:id="@+id/layoutFemale"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:id="@+id/imageFemale"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_female_24"
                android:layout_marginTop="15dp"
                android:contentDescription="@string/DescriptionImageFemale"/>
            <TextView
                android:id="@+id/textSimbolFemale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:text="@string/subtitleSimbolFemale"
                android:gravity="center"
                android:textColor="@color/titleColor"
                />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewHeight"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/cardMale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:orientation="vertical"
        app:cardBackgroundColor="@color/secondCardBackground"
        app:strokeColor="@color/secondCardBackground">
        <LinearLayout
            android:id="@+id/layoutHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15dp">
        <TextView
            android:id="@+id/textViewHeightTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titleHeight"
            android:textColor="@color/titleColor"
            android:gravity="center"
            android:textSize="20sp"
            />
            <LinearLayout
                android:id="@+id/layoutInches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="5dp"
                android:focusable="false"
                android:importantForAccessibility="yes">
                <TextView
                    android:id="@+id/textViewTotalInches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/totalInches"
                    android:textColor="@color/white"
                    android:textSize="35sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"/>
                <TextView
                    android:id="@+id/textViewTextInches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/textInches"
                    android:textColor="@color/white"
                    android:layout_gravity="bottom"
                    android:textSize="15sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutSeekBarInches"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp">
                <SeekBar
                    android:id="@+id/seekBarInches"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:thumbTint="@color/colorBarraAndCalculate"
                    android:progressTint="@color/colorBarraAndCalculate"
                    android:thumb="@drawable/thumb_size" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewWeight"
        android:layout_width="0dp"
        android:layout_height="170dp"
        app:layout_constraintTop_toBottomOf="@id/cardViewHeight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardViewAge"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp"
        app:cardBackgroundColor="@color/cardBackground"
        app:strokeColor="@color/cardBackground">
        <LinearLayout
            android:id="@+id/layoutWeight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/textViewWeightTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titleWeight"
                android:textColor="@color/titleColor"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/textViewWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="50sp"
                android:textColor="@color/white"
                android:text="@string/numWeight"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-black">
            </TextView>
            <LinearLayout
                android:id="@+id/layoutBtnWeight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                >
                <Button
                    android:id="@+id/btnLessWeight"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="@string/simbolLess"
                    android:textStyle="bold"
                    android:textSize="32sp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="15dp"
                    android:backgroundTint="@color/colorBtn"
                    app:cornerRadius="28dp"
                    android:padding="0sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:includeFontPadding="false"
                    android:contentDescription="@string/descriptionBtnLessWeight"
                    style="?android:attr/buttonBarButtonStyle">
                </Button>
                <Button
                    android:id="@+id/btnFurtherWeight"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="@string/simbolFurther"
                    android:textStyle="bold"
                    android:textSize="32sp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="30dp"
                    android:backgroundTint="@color/colorBtn"
                    app:cornerRadius="28dp"
                    android:padding="0sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:includeFontPadding="false"
                    style="?android:attr/buttonBarButtonStyle"
                    android:contentDescription="@string/descriptionBtnFurtherWeight">
                </Button>

            </LinearLayout>
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewAge"
        android:layout_width="0dp"
        android:layout_height="170dp"
        app:layout_constraintTop_toBottomOf="@id/cardViewHeight"
        app:layout_constraintStart_toEndOf="@id/cardViewWeight"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@color/cardBackground"
        app:strokeColor="@color/cardBackground"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp">
        <LinearLayout
            android:id="@+id/layoutAge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/textViewAgeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titleAge"
                android:textColor="@color/titleColor"
                android:gravity="center"
                android:textSize="20sp"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/textViewAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="50sp"
                android:textColor="@color/white"
                android:text="@string/numAge"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-black">
            </TextView>
            <LinearLayout
                android:id="@+id/layoutBtnAge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                >
                <Button
                    android:id="@+id/btnLessAge"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="@string/simbolLess"
                    android:textStyle="bold"
                    android:textSize="32sp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="10dp"
                    android:layout_marginStart="15dp"
                    android:backgroundTint="@color/colorBtn"
                    app:cornerRadius="30dp"
                    android:padding="0sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:includeFontPadding="false"
                    style="?android:attr/buttonBarButtonStyle"
                    android:contentDescription="@string/descriptionBtnLessAge">
                </Button>
                <Button
                    android:id="@+id/btnFurtherAge"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="@string/simbolFurther"
                    android:textStyle="bold"
                    android:textSize="32sp"
                    android:textColor="@color/black"
                    android:layout_marginEnd="30dp"
                    android:backgroundTint="@color/colorBtn"
                    app:cornerRadius="28dp"
                    android:padding="0sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:includeFontPadding="false"
                    style="?android:attr/buttonBarButtonStyle"
                    android:contentDescription="@string/descriptionBtnFurtherAge">
                </Button>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardViewCalculate"
        app:layout_constraintTop_toBottomOf="@+id/cardViewWeight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0"
        android:layout_width="0sp"
        android:layout_height="80dp"
        android:layout_marginTop="15dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/colorBarraAndCalculate"
        app:strokeColor="@color/colorBarraAndCalculate">
        <TextView
            android:id="@+id/textViewCalculate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/textCalculate"
            android:textSize="30sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp">
        </TextView>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>